    {
      "name": "Création (POST)",
      "item": [
        {
          "name": "Ajouter un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Vérifier que le statut est 200 ou 201\r\npm.test(\"Statut de création valide\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\n// Extraire l'ID du produit créé et le stocker dans une variable globale/environnement\r\nvar jsonData = pm.response.json();\r\npm.environment.set(\"createdProductId\", jsonData.id);\r\nconsole.log(\"ID du produit créé : \" + jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Casque Audio Sans Fil\",\r\n  \"price\": 129.99,\r\n  \"category\": \"audio\",\r\n  \"stock\": 25\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "add"
              ]
            }
          },
          "response": []
